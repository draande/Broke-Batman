# Required — the credentials below are for local development only.
DATABASE_URL="postgresql://batman:batman@127.0.0.1:5432/broke_batman?schema=public"
APP_URL="http://localhost:3000"

# Authentication — replace this before starting the application.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Optional extraction provider — leave blank to use local text/JSON-LD parsing.
# Requests contain job postings, not recruiter emails. Use a trusted HTTPS endpoint.
EXTRACTION_API_URL=""
EXTRACTION_API_KEY=""
EXTRACTION_MODEL=""

# Demo — public workspace creation is opt-in in production.
DEMO_ENABLED="false"
# Only required by npm run db:seed; use a unique password, 12–72 UTF-8 bytes.
DEMO_PASSWORD=""

# Optional Google/Gmail — demo inbox needs none of these.
# Register APP_URL/api/gmail/oauth/callback exactly in your Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Independent 32-byte hex encryption key. Generate using the command above.
GMAIL_TOKEN_KEY=

# Optional Docker database password; keep DATABASE_URL in sync for host commands.
# POSTGRES_PASSWORD=
